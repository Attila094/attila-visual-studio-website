# The contact form's KÜLDÉS button (src/app/api/contact/route.ts).
# Copy to `.env.local` and fill in. Without RESEND_API_KEY the endpoint answers
# 501 and the form falls back to opening the visitor's own mail client.

# https://resend.com → API Keys. Free tier covers a portfolio's traffic.
RESEND_API_KEY=

# Optional. Until a domain is verified at Resend, leave this unset and the
# shared sandbox sender is used. After verifying, e.g.:
# CONTACT_FROM="Attila Visual Studio <kapcsolat@attilavisual.studio>"
CONTACT_FROM=

# Optional. Where enquiries land. Defaults to attilakovacs094@gmail.com.
CONTACT_TO=
